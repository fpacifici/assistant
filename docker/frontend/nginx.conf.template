server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Evernote zip imports (see src/assistant/api/routes/imports.py). Uploads can be
    # up to import_max_upload_bytes (500 MB by default, config.yaml), far above nginx's
    # 1 MB default body limit, and running an import can take minutes. The body is
    # streamed to the backend unbuffered, which enforces the real limit (413).
    location ~ ^/imports(/|$) {
        client_max_body_size 512m;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Every backend route prefix (see src/assistant/api/app.py) is proxied through;
    # everything else falls through to the SPA below. Keep this list in sync if a
    # new top-level router prefix is added.
    location ~ ^/(auth|user|invites|notebook|files|tag)(/|$) {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri /index.html;
    }
}
